{
  "expo": {
    "name": "DAP",
    "owner": "dappditos-team",
    "slug": "dap-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "dap",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.alpsstudiowebid.dap",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#8dc54a",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "DAP",
      "shortName": "DAP",
      "themeColor": "#8ec44a",
      "backgroundColor": "#f6fbf0",
      "display": "fullscreen"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#8dc54a",
          "image": "./assets/splash.png",
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Aplikasi ini membutuhkan lokasi Anda untuk menetapkan alamat toko secara akurat."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ceb088f9-ea0b-4436-903c-2e1bae5cbdc4"
      }
    }
  }
}